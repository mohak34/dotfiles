# Dynamic theme colors
config-file = ?"~/.local/state/omarchy/current/theme/ghostty.conf"
window-theme = ghostty

# Font
font-family = "JetBrainsMono Nerd Font"
font-style = bold
font-size = 11


# Window
gtk-titlebar = false
title = ""
confirm-close-surface = false
resize-overlay = never

# Cursor styling
cursor-style = "block"
cursor-style-blink = false

# Shell integration: sudo prompt marker + SSH terminfo
shell-integration-features = no-cursor,no-title,sudo,ssh-env

# Interaction
mouse-hide-while-typing = true
copy-on-select = clipboard
mouse-scroll-multiplier = 3.5

# Free Alt+number for other uses (tmux, etc.)
keybind = alt+zero=unbind
keybind = alt+one=unbind
keybind = alt+two=unbind
keybind = alt+three=unbind
keybind = alt+four=unbind
keybind = alt+five=unbind
keybind = alt+six=unbind
keybind = alt+seven=unbind
keybind = alt+eight=unbind
keybind = alt+nine=unbind

# Fix general slowness on hyprland (https://github.com/ghostty-org/ghostty/discussions/3224)
async-backend = epoll
